<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="vertical_scenario_defs" targetNamespace="http://flowduet.dev/bpmn">
  <bpmn:process id="vertical_scenario" name="竖排推导场景" isExecutable="true">
    <bpmn:startEvent id="start" name="开始">
      <bpmn:outgoing>f_s_init</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="initiate" name="发起申请" flowable:assignee="${initiator}">
      <bpmn:incoming>f_s_init</bpmn:incoming>
      <bpmn:outgoing>f_init_c1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="cond1_fork" name="金额判断">
      <bpmn:incoming>f_init_c1</bpmn:incoming>
      <bpmn:outgoing>f_c1_par</bpmn:outgoing>
      <bpmn:outgoing>f_c1_dir</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="par_fork" name="并行开始">
      <bpmn:incoming>f_c1_par</bpmn:incoming>
      <bpmn:outgoing>f_par_cs</bpmn:outgoing>
      <bpmn:outgoing>f_par_hr</bpmn:outgoing>
      <bpmn:outgoing>f_par_seq</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="par_join" name="并行结束">
      <bpmn:incoming>f_cs_join</bpmn:incoming>
      <bpmn:incoming>f_hr_pj</bpmn:incoming>
      <bpmn:incoming>f_seq_join</bpmn:incoming>
      <bpmn:outgoing>f_pj_j1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="hr_approve" name="HR 审批" flowable:assignee="${hr}">
      <bpmn:incoming>f_par_hr</bpmn:incoming>
      <bpmn:outgoing>f_hr_pj</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="director_approve" name="总监审批" flowable:assignee="${director}">
      <bpmn:incoming>f_c1_dir</bpmn:incoming>
      <bpmn:outgoing>f_dir_c2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="cond2_fork" name="是否通过">
      <bpmn:incoming>f_dir_c2</bpmn:incoming>
      <bpmn:outgoing>f_c2_rect</bpmn:outgoing>
      <bpmn:outgoing>f_c2_arch</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="cond2_join" name="汇聚">
      <bpmn:incoming>f_rect_j2</bpmn:incoming>
      <bpmn:incoming>f_arch_j2</bpmn:incoming>
      <bpmn:outgoing>f_j2_j1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="rectify" name="整改" flowable:assignee="${owner}">
      <bpmn:incoming>f_c2_rect</bpmn:incoming>
      <bpmn:outgoing>f_rect_j2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="archive_review" name="归档复核" flowable:assignee="${auditor}">
      <bpmn:incoming>f_c2_arch</bpmn:incoming>
      <bpmn:outgoing>f_arch_j2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="cond1_join" name="汇聚">
      <bpmn:incoming>f_pj_j1</bpmn:incoming>
      <bpmn:incoming>f_j2_j1</bpmn:incoming>
      <bpmn:outgoing>f_j1_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end" name="结束">
      <bpmn:incoming>f_j1_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="counter_sign" name="部门会签" flowable:assignee="${assignee}">
      <bpmn:incoming>f_par_cs</bpmn:incoming>
      <bpmn:outgoing>f_cs_join</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics flowable:collection="${approvers}" flowable:elementVariable="assignee">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${nrOfCompletedInstances == nrOfInstances}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:userTask id="sequential_sign" name="逐级审批" flowable:assignee="${assignee}">
      <bpmn:incoming>f_par_seq</bpmn:incoming>
      <bpmn:outgoing>f_seq_join</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" flowable:collection="${chain}" flowable:elementVariable="assignee" />
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f_c1_par" sourceRef="cond1_fork" targetRef="par_fork" />
    <bpmn:sequenceFlow id="f_par_cs" sourceRef="par_fork" targetRef="counter_sign" />
    <bpmn:sequenceFlow id="f_par_hr" sourceRef="par_fork" targetRef="hr_approve" />
    <bpmn:sequenceFlow id="f_par_seq" sourceRef="par_fork" targetRef="sequential_sign" />
    <bpmn:sequenceFlow id="f_cs_join" sourceRef="counter_sign" targetRef="par_join" />
    <bpmn:sequenceFlow id="f_hr_pj" sourceRef="hr_approve" targetRef="par_join" />
    <bpmn:sequenceFlow id="f_seq_join" sourceRef="sequential_sign" targetRef="par_join" />
    <bpmn:sequenceFlow id="f_pj_j1" sourceRef="par_join" targetRef="cond1_join" />
    <bpmn:sequenceFlow id="f_s_init" sourceRef="start" targetRef="initiate" />
    <bpmn:sequenceFlow id="f_init_c1" sourceRef="initiate" targetRef="cond1_fork" />
    <bpmn:sequenceFlow id="f_c1_dir" sourceRef="cond1_fork" targetRef="director_approve" />
    <bpmn:sequenceFlow id="f_dir_c2" sourceRef="director_approve" targetRef="cond2_fork" />
    <bpmn:sequenceFlow id="f_c2_rect" sourceRef="cond2_fork" targetRef="rectify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!passed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_rect_j2" sourceRef="rectify" targetRef="cond2_join" />
    <bpmn:sequenceFlow id="f_c2_arch" sourceRef="cond2_fork" targetRef="archive_review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${passed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_arch_j2" sourceRef="archive_review" targetRef="cond2_join" />
    <bpmn:sequenceFlow id="f_j2_j1" sourceRef="cond2_join" targetRef="cond1_join" />
    <bpmn:sequenceFlow id="f_j1_end" sourceRef="cond1_join" targetRef="end" />
  </bpmn:process>
