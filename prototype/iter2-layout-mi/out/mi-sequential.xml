<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn" id="mi_sequential_defs" targetNamespace="http://flowduet.dev/bpmn">
  <bpmn:process id="mi_sequential" name="多实例三档验证 · sequential" isExecutable="true">
    <bpmn:startEvent id="start" name="开始">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end" name="结束">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="seq_sign" name="逐级审批" flowable:assignee="${assignee}">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" flowable:collection="chain" flowable:elementVariable="assignee" />
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="seq_sign" />
    <bpmn:sequenceFlow id="f2" sourceRef="seq_sign" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
