<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowduet="urn:flowduet:bpmn" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="release_ui_default_defs" targetNamespace="http://flowduet.dev/bpmn">
  <bpmn:process id="release_ui_default" name="发布验收-default" isExecutable="true" flowduet:defaultFormKey="form_release">
    <bpmn:startEvent id="s" name="开始">
      <bpmn:outgoing>sf</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="fork" name="金额分支" default="fa">
      <bpmn:incoming>sf</bpmn:incoming>
      <bpmn:outgoing>fa</bpmn:outgoing>
      <bpmn:outgoing>fb</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a" name="首审批" flowable:assignee="${assignee}">
      <bpmn:incoming>fa</bpmn:incoming>
      <bpmn:outgoing>at</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" flowable:collection="approvers" flowable:elementVariable="assignee" />
    </bpmn:userTask>
    <bpmn:userTask id="tail" name="后续审批" flowable:assignee="bob" flowable:formKey="form_release">
      <bpmn:incoming>at</bpmn:incoming>
      <bpmn:outgoing>tj</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="b" name="另一支路审批" flowable:assignee="carol">
      <bpmn:incoming>fb</bpmn:incoming>
      <bpmn:outgoing>bj</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="join">
      <bpmn:incoming>bj</bpmn:incoming>
      <bpmn:incoming>tj</bpmn:incoming>
      <bpmn:outgoing>je</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e" name="结束">
      <bpmn:incoming>je</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="sf" sourceRef="s" targetRef="fork" />
    <bpmn:sequenceFlow id="fa" name="支路甲" sourceRef="fork" targetRef="a" />
    <bpmn:sequenceFlow id="fb" sourceRef="fork" targetRef="b">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 100}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="bj" sourceRef="b" targetRef="join" />
    <bpmn:sequenceFlow id="tj" sourceRef="tail" targetRef="join" />
    <bpmn:sequenceFlow id="je" sourceRef="join" targetRef="e" />
    <bpmn:sequenceFlow id="at" sourceRef="a" targetRef="tail" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="release_ui_default_di">
    <bpmndi:BPMNPlane id="release_ui_default_plane" bpmnElement="release_ui_default">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="167" y="40" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fork_di" bpmnElement="fork">
        <dc:Bounds x="160" y="136" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_di" bpmnElement="a">
        <dc:Bounds x="40" y="256" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tail_di" bpmnElement="tail">
        <dc:Bounds x="40" y="396" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b_di" bpmnElement="b">
        <dc:Bounds x="230" y="256" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join_di" bpmnElement="join">
        <dc:Bounds x="160" y="546" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="167" y="656" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sf_di" bpmnElement="sf">
        <di:waypoint x="185" y="76" />
        <di:waypoint x="185" y="136" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fa_di" bpmnElement="fa">
        <di:waypoint x="176.66666666666669" y="186" />
        <di:waypoint x="176.66666666666669" y="194" />
        <di:waypoint x="90" y="194" />
        <di:waypoint x="90" y="256" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fb_di" bpmnElement="fb">
        <di:waypoint x="193.33333333333331" y="186" />
        <di:waypoint x="193.33333333333331" y="202" />
        <di:waypoint x="280" y="202" />
        <di:waypoint x="280" y="256" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="bj_di" bpmnElement="bj">
        <di:waypoint x="280" y="336" />
        <di:waypoint x="280" y="530" />
        <di:waypoint x="193.33333333333331" y="530" />
        <di:waypoint x="193.33333333333331" y="546" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tj_di" bpmnElement="tj">
        <di:waypoint x="90" y="476" />
        <di:waypoint x="90" y="538" />
        <di:waypoint x="176.66666666666669" y="538" />
        <di:waypoint x="176.66666666666669" y="546" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="je_di" bpmnElement="je">
        <di:waypoint x="185" y="596" />
        <di:waypoint x="185" y="656" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="at_di" bpmnElement="at">
        <di:waypoint x="90" y="336" />
        <di:waypoint x="90" y="396" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
