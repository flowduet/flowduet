  const labels=['文本','多行文本','数字','单选','多选','下拉单选','日期','开关'];
  for(const label of labels)await root.locator('._fc-m-drag ._fd-drag-tool').filter({has:page.locator('.el-form-item__label',{hasText:new RegExp('^甲'+label+'$')})}).last().click();
  await page.locator('[data-test=seam-clear]').click();
  const row=root.locator('._fc-m-drag ._fd-drag-tool').first();await row.hover();await row.locator(':scope > ._fd-drag-r .icon-delete').click();
  const trace=await events();const deleted=trace.find(e=>e.event==='public-delete');
  rows.push({case:'parent-delete-descendant-token-reachability',run,source:'native-pointer',deleted,trace,pass:deleted?.detail.knownSubtree.filter(x=>x.field).length===8});
 }
 for(const layout of ['top','grid']) {
  await page.locator('[data-test=seam-layout]').selectOption(layout);await page.locator('[data-test=seam-load]').click();
  const card=root.locator('._fc-m-drag ._fd-drag-tool').filter({has:page.locator('.el-form-item__label',{hasText:'甲数字'})}).last();
  await card.click();await page.waitForFunction(()=>{const es=JSON.parse(document.querySelector('[data-test=seam-events]').textContent);const a=es.filter(e=>e.event==='public-active'&&e.detail.owner==='A'&&e.detail.field==='a_amount').at(-1);return a&&es.some(e=>e.event==='sample-mounted'&&e.detail.token===a.detail.token);});let trace=await events();const token=trace.filter(e=>e.event==='sample-mounted'&&e.detail.field==='a_amount').at(-1).detail.token;
  const dest=root.locator('._fc-m-drag ._fd-drag-tool').filter({has:page.locator('.el-form-item__label',{hasText:'甲文本'})}).last();
  await card.locator('.icon-move').dragTo(dest,{targetPosition:{x:15,y:10}});
  await page.locator('[data-test=seam-text-A]').click();await page.locator('[data-test=seam-number-A]').click();await page.locator('[data-seam-input=A][data-field=a_amount]').waitFor();trace=await events();const after=trace.filter(e=>e.event==='sample-mounted'&&e.detail.field==='a_amount').at(-1).detail.token;
  rows.push({case:'sort-source-token-stable',layout,source:'native-pointer-drag',token,after,trace:trace.filter(e=>e.event.startsWith('native-drag')||e.event==='sample-mounted'),pass:token===after});
 }
 return rows;
})(page);
