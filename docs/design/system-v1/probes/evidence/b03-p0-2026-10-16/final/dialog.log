  await page.locator('.b03-seam-dialog').getByText('内部弹层',{exact:true}).click();
  await page.keyboard.press('Escape');const popupEscapeKept=await visible();
  await page.locator('[data-test=dialog-normal]').click();
  let trace=await events();rows.push({case:'guarded-idle-popup-normal',run,source:'native-pointer-keyboard',idleEscapeKept,popupEscapeKept,trace,pass:idleEscapeKept&&popupEscapeKept&&trace.some(e=>e.event==='dialog-normal')&&!trace.some(e=>e.event==='dialog-before-close')});
