await (async (page) => {
  if(!page.url().includes('/probes/stage-zero/index.html'))await page.goto('http://127.0.0.1:5173/probes/stage-zero/index.html');
  if(!(await page.locator('[data-test=form-state-probe]').count()))await page.getByRole('button',{name:'表单状态 C',exact:true}).click();
  page.setDefaultTimeout(5000);
  const cases=[{"field": "F08", "layout": "top"}, {"field": "F08", "layout": "grid"}],results=[];
  const labels=['文本','多行文本','数字','单选','多选','下拉单选','日期','开关'];
  const fieldNames=['subject','notes','amount','priority','areas','department','date','urgent'];
  const leaves=rs=>rs.flatMap(r=>r.children?leaves(r.children):[r]);
  for(const item of cases){
