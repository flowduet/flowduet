      "brandPreset": 8
    },
    "panelWidth": {
      "default": 360,
      "suggestedMin": 320,
      "suggestedMax": 440,
      "unit": "px",
      "constraint": "受宿主容器与画布剩余空间共同约束；本轮不确认产品最小可用宽度"
    },
    "density": {
      "values": ["comfortable", "compact"],
      "default": "comfortable",
      "epSize": {
        "comfortable": "default",
        "compact": "small"
      }
    },
    "invalidPolicy": "候选规则：类型错误、非有限数值、超范围值拒绝该项并回退默认，同时提供可读提示；准确接口与错误通道待适配阶段审阅",
    "colorPolicy": "宿主只提供主色种子与可选辅助色种子；按 derivation 生成成套角色并检查，失败时拒绝该种子、回退跟随宿主并提示原因"
  },
  "reviewTargets": {
    "textContrast": 4.5,
    "nonTextContrast": 3,
    "note": "本轮设计检查目标；禁用态单列，不据此宣称整个产品满足可访问性标准",
