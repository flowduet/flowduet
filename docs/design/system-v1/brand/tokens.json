  "derivation": {
    "space": "oklch",
    "summary": "宿主只提供主色种子与可选辅助色种子；保持种子色相，按明度规则派生成套角色，再逐项检查对比度",
    "roleRules": {
      "primary": "浅色主题原样使用种子；深色主题取明度 params.dark.primaryL，保留色相并在 sRGB 色域内尽量保留彩度",
      "primaryHover/primaryPressed": "在主色明度上加 hoverDL/pressedDL，色相与彩度不变",
      "onPrimary": "按主题顺序尝试白色与同色相深墨色，取首个在主色、悬停、按下三态均达 4.5:1 者",
      "primarySoft": "固定明度 softL，彩度为种子彩度×softCRatio 且不超过 softCMax",
      "primaryInk": "从主色明度起，浅色向暗、深色向亮逐步搜索，直至对表面、画布、内嵌底、primarySoft、approvalSoft 均达 4.5:1；用于选中边框、选中文字与链接",
      "focus": "主色对表面、画布、内嵌底均达 3:1 时用主色，否则用 primaryInk",
      "accent": "原样使用辅助色种子，只做小面积点缀；未提供时退回中性色，不引入 FlowDuet 珊瑚橙",
      "accentSoft/accentInk/onAccent": "同主色规则：固定明度浅底；墨色限制彩度后搜索可读明度，避免浅色主题偏向错误红；只在品牌层用于带文字的点缀",
      "epScale": "品牌预设与种子定制写入实例范围时，light-3/5/7/8/9 与 dark-2 沿用 EP 的混色规则；跟随宿主时不写",
      "followHost": "跟随宿主时主色三态与主色前景直接读取宿主 EP 值，不派生、不改写；相关配对只登记为宿主继承信息。FlowDuet 自有组件只消费派生的 primaryInk、primarySoft、focus"
    },
    "params": {
      "light": {
        "hoverDL": -0.05,
        "pressedDL": -0.1,
        "onInkL": 0.25,
        "onInkCMax": 0.06,
        "softL": 0.955,
        "softCRatio": 0.3,
        "softCMax": 0.035,
        "accentSoftL": 0.965,
        "accentSoftCRatio": 0.25,
        "accentSoftCMax": 0.04,
        "accentInkCMax": 0.11
      },
      "dark": {
        "primaryL": 0.8,
        "hoverDL": 0.05,
        "pressedDL": -0.06,
        "onInkL": 0.25,
        "onInkCMax": 0.06,
        "softL": 0.33,
        "softCRatio": 0.5,
        "softCMax": 0.06,
        "accentSoftL": 0.3,
        "accentSoftCRatio": 0.4,
        "accentSoftCMax": 0.05,
        "accentInkCMax": 0.2
      }
    },
    "neutralRules": {
      "mutedTarget": 4.5,
      "controlBorderTarget": 3,
      "method": "跟随宿主时从宿主正文色向表面色混合，取最接近表面色且对表面、内嵌底、画布仍达标的值；连接线同控件边界"
    },
    "failurePolicy": "对比度目标无法达到时拒绝该种子、回退跟随宿主并给出可读原因，不静默降低目标；类型色差只对已登记预设做硬性检查，对宿主运行时提供的任意种子只提示",
    "checks": {
      "contrastPairs": [
        {
          "kind": "text",
          "pair": "text/surface",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "text/canvas",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "text/inset",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "secondary/surface",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "secondary/canvas",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "secondary/inset",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "muted/surface",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "muted/inset",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "onPrimary/primary",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "onPrimary/primaryHover",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "onPrimary/primaryPressed",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "primaryInk/primarySoft",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "primaryInk/surface",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "primaryInk/approvalSoft",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "accentInk/accentSoft",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "onAccent/accent",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "danger/dangerSoft",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "danger/surface",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "danger/inset",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "success/successSoft",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "warning/warningSoft",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "warning/surface",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "approval/approvalSoft",
          "target": 4.5
        },
        {
          "kind": "text",
          "pair": "condition/conditionSoft",
          "target": 4.5
        },
        {
          "kind": "nonText",
          "pair": "controlBorder/surface",
          "target": 3
        },
        {
          "kind": "nonText",
          "pair": "controlBorder/inset",
          "target": 3
        },
        {
          "kind": "nonText",
          "pair": "focus/surface",
          "target": 3
        },
        {
          "kind": "nonText",
          "pair": "focus/inset",
          "target": 3
        },
        {
          "kind": "nonText",
          "pair": "focus/canvas",
          "target": 3
        },
        {
          "kind": "nonText",
          "pair": "primaryInk/inset",
          "target": 3
        },
        {
          "kind": "nonText",
          "pair": "connector/inset",
          "target": 3
        },
        {
          "kind": "info",
          "pair": "primary/surface",
          "target": 3
        },
        {
          "kind": "info",
          "pair": "primary/inset",
          "target": 3
        }
      ],
      "typeSeparation": {
        "minDeltaEOK": 0.08,
        "pairs": [
          ["approval", "primaryInk"],
          ["approval", "primary"],
          ["condition", "primaryInk"],
          ["condition", "primary"]
        ],
        "note": "节点类型色与选中色在 OKLab 中的最小距离；已登记预设为硬性检查，任意宿主种子只提示。选中仍须同时有 2px 边框与“已选中”文字"
      },
      "hostOwnedRoles": ["primary", "primaryHover", "primaryPressed", "onPrimary"]
    }
  },
  "componentMappings": {
    "button.primary": ["primary", "primaryHover", "primaryPressed", "onPrimary", "focus"],
    "button.pressed": ["primaryInk", "primarySoft"],
    "input": [
      "surface",
      "text",
      "controlBorder",
      "focus",
      "danger",
      "disabledSurface",
      "disabledText"
    ],
    "node.approval": ["surface", "approvalSoft", "approval", "controlBorder"],
    "node.selected": ["primaryInk", "focus"],
    "node.incomplete": ["warning"],
    "branch.condition": ["conditionSoft", "condition", "connector"],
    "form.error": ["danger", "dangerSoft"],
    "state.pending": ["primaryInk", "secondary"],
    "brand.detail": ["accent"],
    "brand.chip": ["accentSoft", "accentInk"]
  },
  "customizationDraft": {
    "primarySeed": {
      "default": "跟随宿主 --el-color-primary",
