<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="parallel_flow_defs" targetNamespace="http://flowduet.dev/bpmn">
  <bpmn:process id="parallel_flow" name="并行审批" isExecutable="true">
    <bpmn:startEvent id="start" name="开始">
      <bpmn:outgoing>f_start_fork</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="fork" name="并行分裂">
      <bpmn:incoming>f_start_fork</bpmn:incoming>
      <bpmn:outgoing>f_fork_hr</bpmn:outgoing>
      <bpmn:outgoing>f_fork_finance</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="hr_review" name="人事审查" flowable:assignee="${hr}">
      <bpmn:incoming>f_fork_hr</bpmn:incoming>
      <bpmn:outgoing>f_hr_join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="finance_review" name="财务核销" flowable:assignee="${finance}">
      <bpmn:incoming>f_fork_finance</bpmn:incoming>
      <bpmn:outgoing>f_finance_join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="join" name="并行汇合">
      <bpmn:incoming>f_hr_join</bpmn:incoming>
      <bpmn:incoming>f_finance_join</bpmn:incoming>
      <bpmn:outgoing>f_join_end</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="end" name="结束">
      <bpmn:incoming>f_join_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_fork" sourceRef="start" targetRef="fork" />
    <bpmn:sequenceFlow id="f_fork_hr" sourceRef="fork" targetRef="hr_review" />
    <bpmn:sequenceFlow id="f_fork_finance" sourceRef="fork" targetRef="finance_review" />
    <bpmn:sequenceFlow id="f_hr_join" sourceRef="hr_review" targetRef="join" />
    <bpmn:sequenceFlow id="f_finance_join" sourceRef="finance_review" targetRef="join" />
    <bpmn:sequenceFlow id="f_join_end" sourceRef="join" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="parallel_flow_di">
    <bpmndi:BPMNPlane id="parallel_flow_plane" bpmnElement="parallel_flow">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="160" y="60" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fork_di" bpmnElement="fork">
        <dc:Bounds x="153" y="150" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="hr_review_di" bpmnElement="hr_review">
        <dc:Bounds x="60" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finance_review_di" bpmnElement="finance_review">
        <dc:Bounds x="200" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join_di" bpmnElement="join">
        <dc:Bounds x="153" y="400" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="160" y="510" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_start_fork_di" bpmnElement="f_start_fork">
        <di:waypoint x="178" y="96" />
        <di:waypoint x="178" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_fork_hr_di" bpmnElement="f_fork_hr">
        <di:waypoint x="153" y="175" />
        <di:waypoint x="110" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_fork_finance_di" bpmnElement="f_fork_finance">
        <di:waypoint x="203" y="175" />
        <di:waypoint x="250" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_hr_join_di" bpmnElement="f_hr_join">
        <di:waypoint x="110" y="340" />
        <di:waypoint x="153" y="425" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_finance_join_di" bpmnElement="f_finance_join">
        <di:waypoint x="250" y="340" />
        <di:waypoint x="203" y="425" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_join_end_di" bpmnElement="f_join_end">
        <di:waypoint x="178" y="450" />
        <di:waypoint x="178" y="510" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
