<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowduet="urn:flowduet:bpmn" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="default_form_flow_defs" targetNamespace="http://flowduet.dev/bpmn">
  <bpmn:process id="default_form_flow" name="默认表单审批" isExecutable="true" flowduet:defaultFormKey="leave_form_v1">
    <bpmn:startEvent id="start" name="开始">
      <bpmn:outgoing>flow_start_solo</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="solo_approval" name="经理审批" flowable:assignee="${manager}" flowable:formKey="manager_form_v1">
      <bpmn:incoming>flow_start_solo</bpmn:incoming>
      <bpmn:outgoing>flow_solo_counter</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="counter_sign" name="部门会签" flowable:assignee="${assignee}">
      <bpmn:incoming>flow_solo_counter</bpmn:incoming>
      <bpmn:outgoing>flow_counter_end</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics flowable:collection="approvers" flowable:elementVariable="assignee">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${nrOfCompletedInstances == nrOfInstances}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:endEvent id="end" name="结束">
      <bpmn:incoming>flow_counter_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_solo" sourceRef="start" targetRef="solo_approval" />
    <bpmn:sequenceFlow id="flow_solo_counter" sourceRef="solo_approval" targetRef="counter_sign" />
    <bpmn:sequenceFlow id="flow_counter_end" sourceRef="counter_sign" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="default_form_flow_di">
    <bpmndi:BPMNPlane id="default_form_flow_plane" bpmnElement="default_form_flow">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="160" y="60" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="solo_approval_di" bpmnElement="solo_approval">
        <dc:Bounds x="140" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="counter_sign_di" bpmnElement="counter_sign">
        <dc:Bounds x="140" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="172" y="440" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_solo_di" bpmnElement="flow_start_solo">
        <di:waypoint x="178" y="96" />
        <di:waypoint x="178" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_solo_counter_di" bpmnElement="flow_solo_counter">
        <di:waypoint x="190" y="240" />
        <di:waypoint x="190" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_counter_end_di" bpmnElement="flow_counter_end">
        <di:waypoint x="190" y="380" />
        <di:waypoint x="190" y="440" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
