{
  "name": "@flowduet/core",
  "version": "0.2.1",
  "description": "FlowDuet 内核：BPMN 模型树 + Parser/Compiler + 引擎适配器",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "bpmn",
    "bpmn20",
    "flowable",
    "workflow",
    "workflow-engine",
    "process-modeling"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowduet/flowduet.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/pack-declarations.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "bpmn-moddle": "^10.2.0"
  }
}
