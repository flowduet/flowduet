{
  "name": "@flowduet/form-create",
  "version": "0.0.0",
  "description": "FlowDuet 表单集成：流程设计文档编解码与组合编辑装配（迭代三构建中）",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/form-create.css"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowduet/flowduet.git",
    "directory": "packages/form-create"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "element-plus": "^2.11.1"
  },
  "dependencies": {
    "@flowduet/core": "workspace:*",
    "@flowduet/designer": "workspace:*",
    "@form-create/designer": "3.5.0",
    "@form-create/element-ui": "3.3.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
