    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@flowduet/core": "workspace:*",
    "@flowduet/designer": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "happy-dom": "^20.14.5",
    "vitest": "^5.0.1"
