{
  "name": "@flowduet/form-create",
  "version": "0.0.0",
  "description": "FlowDuet 表单集成：流程设计文档编解码与组合编辑装配（迭代三构建中）",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
